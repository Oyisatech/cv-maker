<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OyisaTech CV Maker R49</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#f5f7fb;color:#222;font-family:sans-serif}
.header{background:#0f172a;color:#fff;padding:14px}
.container{display:flex;flex-wrap:wrap;gap:14px;padding:14px}
.form{flex:1;min-width:300px;background:#fff;border-radius:14px;padding:14px}
.preview{flex:1;min-width:320px;background:#fff;border-radius:14px;padding:18px}
label{font-weight:700;font-size:12px;margin:8px 0 4px;display:block}
input,textarea{width:100%;padding:11px;border-radius:10px;border:1px solid #ccc}
.btn{width:100%;padding:13px;border:none;border-radius:12px;background:#0f172a;color:#fff;font-weight:800;margin-top:10px}
.btn-green{background:#00c950}
.cv-name{font-size:26px;font-weight:900}
</style>
</head>
<body>
<div class="header"><h1>OyisaTech CV Maker R49 🇿🇦</h1></div>
<div class="container">
<div class="form">
<label>Full Name</label><input id="n" placeholder="Oyisa Mthembu" oninput="u()">
<label>Job Title</label><input id="t" placeholder="Cashier" oninput="u()">
<label>Phone & Email</label><input id="c" placeholder="071..." oninput="u()">
<label>Summary</label><textarea id="sm" oninput="u()"></textarea>
<label>Experience</label><textarea id="ex" oninput="u()"></textarea>
<label>Education</label><textarea id="ed" oninput="u()"></textarea>
<label>Skills</label><input id="sk" placeholder="Customer Service" oninput="u()">
<button class="btn btn-green" onclick="window.print()">Download PDF</button>
</div>
<div class="preview" id="cv"></div>
</div>
<script>
function u(){
let a=n.value||'Your Name',b=t.value||'Job Title',c1=c.value||'Contact',s=sm.value||'Summary',e1=ex.value||'Experience',ed1=ed.value||'Education',sk1=sk.value||'Skills';
cv.innerHTML='<div class=cv-name>'+a+'</div><b>'+b+'</b><p>'+c1+'</p><hr><p>'+s+'</p><p><b>Exp:</b><br>'+e1+'</p><p><b>Edu:</b><br>'+ed1+'</p><p><b>Skills:</b> '+sk1+'</p>';
}u();u();
</script>
</body>
</html>
